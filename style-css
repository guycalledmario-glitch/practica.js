/* CĆ“DIGO CSS */

* {
  margin: 0;
  padding: 0;
}

body {
	background-color: cyan;
	color: darkblue;
	font-family: Arial, Helvetica, sans-serif;
}

.contenedor {
  max-width: 1000px;
  margin: 20px auto;
  display: grid;
  grid-gap: 20px;
  grid-template-columns: repeat(3, 1fr);
  grid-template-rows: repeat(4, auto);
  grid-template-areas:
    "nav nav nav"
    "contenido contenido sidebar"
    "bloque1 bloque1 bloque2 "
    "footer footer footer"
	;
}

.contenido {
	background-color: aliceblue;
  padding: 20px;
  border-radius: 5px;
    grid-area: contenido;
}

nav {
	background-color: green;
	color: white;
	grid-area: nav;
	padding: 20px;
	border-radius: 5px;
}

.sidebar {
  grid-area: sidebar;
  background: red;
  display: flex;
  flex-direction: column;
  justify-content: top; 
  align-items: center; 
  padding: 20px;
	color: aliceblue;
  border-radius: 12px; 
}

.bloque {
  color: black;
  text-align: left;
  flex-direction: column;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 5px;
  padding: 20px;
}

#bloque1 {
  grid-area: bloque1;
  background: pink;
}

#bloque2 {
  grid-area: bloque2;
  background: gray;
}

footer {
  background: orange;
  color: yellow;
  grid-area: footer;
  padding: 20px;
  border-radius: 5px;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
}

@media screen and (max-width: 768px) {
  .contenedor {
    display: flex;
    flex-direction: column;

  }
  
  .
}
